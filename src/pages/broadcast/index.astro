---
import BaseLayout from "@layouts/BaseLayout.astro";
import BroadcastContent from "@components/broadcast/BroadcastContent.astro";
---

<BaseLayout title="Broadcast | Portal MDA">
  <h1 class="sr-only">Broadcast de llamadas en vivo</h1>

  <BroadcastContent server:defer>
    <div slot="fallback" class="space-y-6">
      <div class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
        {
          [1, 2, 3, 4].map(() => (
            <div class="border-base-300 border px-6 py-8 text-center">
              <div class="bg-base-200 mx-auto h-20 w-24 animate-pulse"></div>
              <div class="bg-base-200 mx-auto mt-4 h-5 w-28 animate-pulse"></div>
            </div>
          ))
        }
      </div>
    </div>
  </BroadcastContent>
</BaseLayout>

<script>
  import {
    LLAMADA_ESTADO_LABELS,
    LLAMADA_ESTADO_TONES,
    type LlamadaEstado,
  } from "@/lib/llamadas/estados";
  import { describeCall, formatAge } from "@/lib/broadcast/display";
  import { getCleanBase } from "@/lib/baseUrl";
  import { initFullscreenToggle } from "@/lib/fullscreenToggle";

  interface LlamadaApi {
    callId: number;
    agentName: string;
    state: LlamadaEstado;
    stateLabel: string;
    groupName: string;
    elapsedSeconds: number;
    createdAt: string;
  }

  interface CasoApi {
    id: number;
    prettyId: string;
    title: string;
    categoryId: number;
    categoryName: string;
    creatorName: string | null;
    locationName: string | null;
    /** Epoch en segundos. */
    createdAt: number;
  }

  interface CalidadApi {
    month: string;
    monthLabel: string;
    usedFallback: boolean;
    totalAuditorias: number;
    operadoresAuditados: number;
    promedioGeneral: number | null;
    aprobados: number;
    aprobadosTotal: number;
    porCanal: {
      key: string;
      label: string;
      avg: number | null;
      count: number;
    }[];
    top: {
      agentId: number;
      name: string;
      score: number;
      audits: number;
      quotaFulfilled: boolean;
    }[];
  }

  interface BroadcastApi {
    kpis: {
      active: number;
      attended: number;
      ringing: number;
      enqueued: number;
      ivr: number;
      overflow: number;
      avgWaitSeconds: number;
      avgWaitLabel: string;
    };
    calls: LlamadaApi[];
    fetchedAt: string;
    stale: boolean;
    warning?: string;
    casos: {
      total: number;
      porCategoria: {
        categoryId: number;
        label: string;
        count: number;
      }[];
      casos: CasoApi[];
      actualizadoAt: string;
      warning?: string;
    };
    calidad: CalidadApi;
  }

  const POLL_INTERVAL_MS = 10_000;
  const TICK_INTERVAL_MS = 1_000;

  let pollTimer: number | null = null;
  let tickTimer: number | null = null;
  let requestInFlight = false;

  const getRoot = (): HTMLElement | null =>
    document.querySelector<HTMLElement>("[data-broadcast-root]");

  const formatDuration = (seconds: number): string => {
    const total = Math.max(0, Math.floor(seconds));
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor((total % 3600) / 60);
    const secs = total % 60;
    if (hours > 0) return `${hours}h ${String(minutes).padStart(2, "0")}m`;
    if (minutes > 0) return `${minutes}m ${String(secs).padStart(2, "0")}s`;
    return `${secs}s`;
  };

  const setKpi = (key: string, value: string | number): void => {
    const el = document.querySelector<HTMLElement>(
      `[data-broadcast-kpi="${key}"]`,
    );
    if (!el) return;

    el.textContent = String(value);

    // Gris cuando el estado esta en 0; acento cuando hay llamadas.
    const isZero = Number(value) === 0;
    el.classList.toggle("text-secondary", !isZero);
    el.classList.toggle("text-base-content/40", isZero);
  };

  const buildEstadoBadge = (state: LlamadaEstado, label: string): HTMLElement => {
    const badge = document.createElement("span");
    const tone = LLAMADA_ESTADO_TONES[state] ?? "neutral";
    badge.className = `badge badge-sm badge-soft badge-${tone}`;
    badge.dataset.estadoBadge = "";
    badge.textContent = label || LLAMADA_ESTADO_LABELS[state] || state;
    return badge;
  };

  const renderCalls = (calls: LlamadaApi[]): void => {
    const container = document.querySelector<HTMLElement>(
      "[data-broadcast-cards]",
    );
    const template = document.querySelector<HTMLTemplateElement>(
      "#bcast-tpl-card",
    );
    if (!container || !template?.content.firstElementChild) return;

    container.textContent = "";

    for (const call of calls) {
      const card = template.content.firstElementChild.cloneNode(true) as HTMLElement;

      const estadoField = card.querySelector<HTMLElement>('[data-field="estado"]');
      if (estadoField) {
        estadoField.textContent = "";
        estadoField.appendChild(buildEstadoBadge(call.state, call.stateLabel));
      }

      const tiempoField = card.querySelector<HTMLElement>('[data-field="tiempo"]');
      if (tiempoField) {
        tiempoField.textContent = formatDuration(call.elapsedSeconds ?? 0);
      }

      const agenteField = card.querySelector<HTMLElement>('[data-field="agente"]');
      if (agenteField) {
        const display = describeCall(call);
        agenteField.textContent = display.title;
        agenteField.setAttribute("title", display.title);
      }

      const grupoField = card.querySelector<HTMLElement>('[data-field="grupo"]');
      if (grupoField) {
        const display = describeCall(call);
        grupoField.textContent = display.subtitle;
        grupoField.setAttribute("title", display.subtitle);
      }

      if (call.createdAt) card.dataset.createdAt = call.createdAt;

      container.appendChild(card);
    }

    const total = document.querySelector<HTMLElement>("[data-broadcast-total]");
    if (total) total.textContent = String(calls.length);

    const empty = document.querySelector<HTMLElement>("[data-broadcast-empty]");
    if (empty) empty.hidden = calls.length > 0;
  };

  /** Antigüedad en vivo de los casos de autogestión. */
  const updateCasoAges = (): void => {
    const nowSeconds = Math.floor(Date.now() / 1000);
    document
      .querySelectorAll<HTMLElement>("[data-caso-card][data-created-at]")
      .forEach((card) => {
        const createdAt = Number(card.dataset.createdAt);
        if (!Number.isFinite(createdAt) || createdAt <= 0) return;
        const el = card.querySelector<HTMLElement>('[data-field="edad"]');
        if (el) el.textContent = formatAge(nowSeconds - createdAt);
      });
  };

  const renderCasos = (data: BroadcastApi["casos"]): void => {
    const container = document.querySelector<HTMLElement>("[data-casos-cards]");
    const template = document.querySelector<HTMLTemplateElement>(
      "#bcast-tpl-caso",
    );
    if (!container || !template?.content.firstElementChild) return;

    const casos = data.casos ?? [];
    container.textContent = "";

    for (const caso of casos) {
      const card = template.content.firstElementChild.cloneNode(true) as HTMLElement;

      const setText = (field: string, value: string): void => {
        const el = card.querySelector<HTMLElement>(`[data-field="${field}"]`);
        if (!el) return;
        el.textContent = value;
        el.setAttribute("title", value);
      };

      setText("numero", `#${caso.prettyId}`);
      setText("titulo", caso.title);
      setText("creador", caso.creatorName ?? "Sin creador");
      setText("ubicacion", caso.locationName ?? "");

      const categoria = card.querySelector<HTMLElement>(
        '[data-field="categoria"]',
      );
      if (categoria) {
        categoria.className = "badge badge-sm badge-soft mt-2 badge-info";
        categoria.textContent = caso.categoryName;
        categoria.setAttribute("title", caso.categoryName);
      }

      card.dataset.createdAt = String(caso.createdAt);
      container.appendChild(card);
    }

    // Total + desglose por categoria real.
    const total = document.querySelector<HTMLElement>("[data-casos-total]");
    if (total) total.textContent = String(data.total ?? casos.length);

    const breakdown = document.querySelector<HTMLElement>(
      "[data-casos-breakdown]",
    );
    if (breakdown) {
      breakdown.textContent = "";
      for (const categoria of data.porCategoria ?? []) {
        const badge = document.createElement("span");
        badge.className =
          "badge badge-sm badge-soft badge-ghost font-mono tabular-nums";
        badge.dataset.casosCount = String(categoria.categoryId);
        badge.title = categoria.label;
        badge.textContent = `${categoria.label}: ${categoria.count}`;
        breakdown.appendChild(badge);
      }
    }

    const empty = document.querySelector<HTMLElement>("[data-casos-empty]");
    if (empty) empty.hidden = casos.length > 0;

    updateCasoAges();
  };

  /** Timer en vivo: "3m 12s" de cada llamada, segundo a segundo. */
  const updateElapsed = (): void => {
    const now = Date.now();
    document
      .querySelectorAll<HTMLElement>("[data-broadcast-card][data-created-at]")
      .forEach((card) => {
        const created = card.dataset.createdAt;
        if (!created) return;
        const started = new Date(created).getTime();
        if (Number.isNaN(started)) return;
        const seconds = Math.max(0, Math.floor((now - started) / 1000));
        const el = card.querySelector<HTMLElement>('[data-field="tiempo"]');
        if (el) el.textContent = formatDuration(seconds);
      });
  };

  const updateFreshness = (): void => {
    const root = getRoot();
    if (!root) return;
    const el = root.querySelector<HTMLElement>("[data-broadcast-freshness]");
    if (!el) return;

    const fetchedAt = root.dataset.fetchedAt;
    if (!fetchedAt) {
      el.textContent = "--";
      return;
    }

    const seconds = Math.max(
      0,
      Math.floor((Date.now() - new Date(fetchedAt).getTime()) / 1000),
    );
    if (seconds < 5) {
      el.textContent = "actualizado ahora";
    } else if (seconds < 60) {
      el.textContent = `actualizado hace ${seconds}s`;
    } else {
      el.textContent = `actualizado hace ${Math.floor(seconds / 60)} min`;
    }
  };

  const scoreTextClass = (avg: number | null): string => {
    if (avg === null || Number.isNaN(avg)) return "text-base-content/40";
    if (avg >= 85) return "text-success";
    if (avg >= 70) return "text-warning";
    return "text-error";
  };

  const formatScore = (avg: number | null): string =>
    avg === null || Number.isNaN(avg) ? "--" : `${Math.round(avg)}%`;

  /** Actualiza el bloque de calidad. */
  const renderCalidad = (calidad: CalidadApi): void => {
    const section = document.querySelector<HTMLElement>(
      "[data-broadcast-quality]",
    );
    if (!section) return;

    const mes = section.querySelector<HTMLElement>("[data-calidad-mes]");
    if (mes) mes.textContent = calidad.monthLabel || "--";

    // Top de operadores.
    const lista = section.querySelector<HTMLElement>("[data-top-operadores]");
    const template = document.querySelector<HTMLTemplateElement>(
      "#bcast-tpl-top",
    );
    if (lista && template?.content.firstElementChild) {
      lista.textContent = "";
      const posiciones = ["1º", "2º", "3º"];

      calidad.top.forEach((operador, index) => {
        const item = template.content.firstElementChild!.cloneNode(
          true,
        ) as HTMLElement;

        const posicion = item.querySelector<HTMLElement>(
          '[data-field="posicion"]',
        );
        if (posicion) {
          posicion.textContent = posiciones[index] ?? `${index + 1}º`;
          posicion.classList.toggle("text-secondary", index === 0);
          posicion.classList.toggle("text-base-content/40", index !== 0);
        }

        const nombre = item.querySelector<HTMLElement>(
          '[data-field="nombre"]',
        );
        if (nombre) nombre.textContent = operador.name;

        const detalle = item.querySelector<HTMLElement>(
          '[data-field="detalle"]',
        );
        if (detalle) {
          detalle.textContent = `${operador.audits} auditorías${
            operador.quotaFulfilled ? " · cuota completa" : ""
          }`;
        }

        const score = item.querySelector<HTMLElement>('[data-field="score"]');
        if (score) {
          score.textContent = formatScore(operador.score);
          score.className = `font-mono text-3xl font-black tabular-nums ${scoreTextClass(
            operador.score,
          )}`;
        }

        lista.appendChild(item);
      });
    }

    // Tabla de promedios.
    const filas: { key: string; avg: number | null; count: number }[] = [
      {
        key: "general",
        avg: calidad.promedioGeneral,
        count: calidad.totalAuditorias,
      },
      ...calidad.porCanal.map((canal) => ({
        key: canal.key,
        avg: canal.avg,
        count: canal.count,
      })),
    ];

    for (const fila of filas) {
      const row = section.querySelector<HTMLElement>(
        `[data-calidad-row="${fila.key}"]`,
      );
      if (!row) continue;

      const count = row.querySelector<HTMLElement>('[data-field="count"]');
      if (count) count.textContent = String(fila.count);

      const avg = row.querySelector<HTMLElement>('[data-field="avg"]');
      if (avg) {
        avg.textContent = formatScore(fila.avg);
        avg.className = `font-mono text-lg font-bold tabular-nums ${scoreTextClass(
          fila.avg,
        )}`;
      }
    }

    const aprobados = section.querySelector<HTMLElement>(
      "[data-calidad-aprobados]",
    );
    if (aprobados) {
      aprobados.textContent = `${calidad.aprobados}/${calidad.aprobadosTotal}`;
    }
  };

  const applySnapshot = (data: BroadcastApi): void => {
    const root = getRoot();
    if (!root) return;

    root.dataset.fetchedAt = data.fetchedAt;
    setKpi("ivr", data.kpis.ivr);
    setKpi("enqueued", data.kpis.enqueued);
    setKpi("attended", data.kpis.attended);
    setKpi("ringing", data.kpis.ringing);
    renderCalls(data.calls ?? []);
    renderCasos(data.casos);
    renderCalidad(data.calidad);
    updateFreshness();
    updateElapsed();
  };

  const fetchSnapshot = async (): Promise<void> => {
    if (requestInFlight) return;
    requestInFlight = true;

    try {
      const url = `${getCleanBase()}api/broadcast/estado`;
      const response = await fetch(url, {
        headers: { Accept: "application/json" },
        credentials: "same-origin",
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      applySnapshot((await response.json()) as BroadcastApi);
    } catch (error) {
      console.warn("[Broadcast] No se pudo refrescar el snapshot:", error);
    } finally {
      requestInFlight = false;
    }
  };

  const startPolling = (): void => {
    if (pollTimer !== null) return;
    pollTimer = window.setInterval(() => {
      void fetchSnapshot();
    }, POLL_INTERVAL_MS);
  };

  const initBroadcast = (): void => {
    const root = getRoot();
    if (!root) return;
    if (root.dataset.bcastInit === "true") return;
    root.dataset.bcastInit = "true";

    updateFreshness();
    startPolling();
  };

  document.addEventListener("astro:page-load", initBroadcast);

  // Boton "Pantalla completa" (mismo mecanismo que las tablas del portal).
  initFullscreenToggle();

  // El server island se resuelve de forma diferida: se espera a que aparezca.
  const observer = new MutationObserver(() => {
    initBroadcast();
  });
  observer.observe(document.body, { childList: true, subtree: true });

  initBroadcast();

  if (tickTimer === null) {
    tickTimer = window.setInterval(() => {
      updateFreshness();
      updateElapsed();
      updateCasoAges();
    }, TICK_INTERVAL_MS);
  }
</script>
