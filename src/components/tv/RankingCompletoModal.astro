---
import Modal from "@components/ui/Modal.astro";
import { formatScore, scoreToneClass } from "@/lib/tv/display";
import type { CalidadResumenTv } from "@/lib/calidad/resumenTv";

interface Props {
  resumen: CalidadResumenTv;
}

const { resumen } = Astro.props;
const vacio = resumen.ranking.length === 0;
---

<Modal
  id="tv-ranking-modal"
  title="Ranking de operadores"
  size="3xl"
  titleClass="pr-10 text-lg font-bold"
  closeButton
  class="flex flex-col overflow-hidden"
>
  <div slot="content" class="flex min-h-0 flex-1 flex-col">
    <div class="min-h-0 flex-1 overflow-y-auto" data-tv-modal-scroll>
      <table
        class="w-full table-fixed border-collapse text-sm"
        data-tv-modal-table
        hidden={vacio}
      >
        <thead class="bg-base-100 sticky top-0 z-10 text-left">
          <tr class="border-base-300 border-b">
            <th
              scope="col"
              class="text-base-content/70 w-16 py-2 pr-3 text-xs font-semibold sm:w-20"
            >
              Posición
            </th>
            <th
              scope="col"
              class="text-base-content/70 py-2 pr-3 text-xs font-semibold"
            >
              Operador
            </th>
            <th
              scope="col"
              class="text-base-content/70 w-20 py-2 pr-3 text-right text-xs font-semibold sm:w-24"
            >
              Auditorías
            </th>
            <th
              scope="col"
              class="text-base-content/70 w-20 py-2 text-right text-xs font-semibold sm:w-24"
            >
              Promedio
            </th>
          </tr>
        </thead>
        <tbody data-tv-modal-body>
          {
            resumen.ranking.map((operador, index) => (
              <tr
                class:list={[
                  "border-base-300 border-b last:border-0",
                  index === 0 && "bg-base-200/50",
                ]}
                data-tv-modal-row
              >
                <td class="py-1.5 pr-3">
                  <span
                    class:list={[
                      "font-mono text-sm font-bold tabular-nums",
                      index === 0
                        ? "text-secondary dark:text-accent"
                        : "text-base-content/70",
                    ]}
                    data-field="posicion"
                  >
                    {index + 1}º
                  </span>
                </td>
                <td class="py-1.5 pr-3">
                  <span
                    class="text-base-content block truncate font-semibold"
                    data-field="nombre"
                  >
                    {operador.name}
                  </span>
                </td>
                <td
                  class="text-base-content/70 py-1.5 pr-3 text-right font-mono text-xs tabular-nums"
                  data-field="auditorias"
                >
                  {operador.audits}
                </td>
                <td
                  class:list={[
                    "py-1.5 text-right font-mono text-lg font-bold tabular-nums",
                    scoreToneClass(operador.score),
                  ]}
                  data-field="score"
                >
                  {formatScore(operador.score)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <p
        class="text-base-content/70 py-10 text-center text-sm"
        data-tv-modal-empty
        hidden={!vacio}
      >
        Todavía no hay auditorías suficientes para armar el ranking.
      </p>
    </div>
  </div>
</Modal>

<template id="tv-tpl-modal-row">
  <tr class="border-base-300 border-b last:border-0" data-tv-modal-row>
    <td class="py-1.5 pr-3">
      <span
        class="font-mono text-sm font-bold tabular-nums"
        data-field="posicion"></span>
    </td>
    <td class="py-1.5 pr-3">
      <span
        class="text-base-content block truncate font-semibold"
        data-field="nombre"></span>
    </td>
    <td
      class="text-base-content/70 py-1.5 pr-3 text-right font-mono text-xs tabular-nums"
      data-field="auditorias"
    ></td>
    <td
      class="py-1.5 text-right font-mono text-lg font-bold tabular-nums"
      data-field="score"></td>
  </tr>
</template>
