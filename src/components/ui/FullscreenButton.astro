---
import { Icon } from "astro-icon/components";
import ActionButton from "./ActionButton.astro";

interface Props {
  targetLabel?: string;
  size?: "xs" | "sm" | "md" | "default";
  variant?: "solid" | "soft" | "outline" | "ghost";
  /** Texto visible junto al ícono (ej. "Pantalla completa"). */
  label?: string;
  class?: string;
}

const {
  targetLabel = "pantalla completa",
  size = "xs",
  variant = "ghost",
  label,
  class: className = "",
} = Astro.props;
---

<ActionButton
  type="button"
  variant={variant}
  size={size}
  data-fullscreen-toggle
  title="Ver en pantalla completa"
  ariaLabel={`Ver ${targetLabel} en pantalla completa`}
  class={className}
>
  <Icon name="boxicons:fullscreen" size={16} data-fs-enter is:inline />
  <Icon
    name="boxicons:fullscreen-exit"
    size={16}
    class="hidden"
    data-fs-exit
    is:inline
  />
  {label && <span class="fs-text text-xs">{label}</span>}
</ActionButton>
