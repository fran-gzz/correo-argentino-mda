---
import { formatAge } from "@/lib/broadcast/display";
import type { CasoAutogestion } from "@/lib/invgate/casosAutogestion";

interface Props {
  caso: CasoAutogestion;
}

const { caso } = Astro.props;
---

<article
  class="border-base-300 bg-base-100 border p-4"
  data-caso-card
  data-created-at={caso.createdAt}
>
  <div class="flex items-center justify-between gap-2">
    <span class="text-base-content font-mono text-sm font-bold">
      #{caso.prettyId}
    </span>
    <span
      class="text-base-content/60 font-mono text-xs tabular-nums"
      data-field="edad"
    >
      {formatAge(caso.ageHours * 3600)}
    </span>
  </div>

  <span class="badge badge-sm badge-soft badge-info mt-2" data-field="categoria">
    {caso.categoryName}
  </span>

  <p
    class="text-base-content mt-2 truncate text-sm font-semibold"
    title={caso.title}
    data-field="titulo"
  >
    {caso.title}
  </p>

  <p
    class="text-base-content/60 truncate text-xs"
    title={caso.creatorName ?? ""}
    data-field="creador"
  >
    {caso.creatorName ?? "Sin creador"}
  </p>

  <p
    class="text-base-content/60 truncate text-xs"
    title={caso.locationName ?? ""}
    data-field="ubicacion"
  >
    {caso.locationName ?? ""}
  </p>
</article>
